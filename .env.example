# ==========================================
# Frontend Configuration (frontend/.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# Backend Configuration (backend/.env)
# ==========================================
PROJECT_NAME="Image-to-Video Walkthrough Generation"
VERSION=0.6.0
API_PREFIX=/api
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API access key (recommended whenever the backend is reachable from the internet).
# When set, every /api request must send it as the X-API-Key header (or ?key=).
# /api/health and the /file media routes stay open so the UI can load media.
API_ACCESS_KEY=
NEXT_PUBLIC_API_KEY=

# Image Ingestion Constraints
MAX_IMAGE_SIZE_BYTES=20971520
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512

# AI Multimodal Vision (Phase 2 Scene Understanding)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0

# Image-to-Video Provider (Phase 4)
# VIDEO_PROVIDER: auto | json2video | gemini_veo | kenburns
#   auto       -> best configured remote, local Ken Burns fallback on quota/misconfig
#   json2video -> JSON2Video cloud renderer (generous free tier; needs a public base URL)
#   gemini_veo -> Google Veo only (true generative video; hardest free tier)
#   kenburns   -> fully local cinematic camera motion, no API and no quota
VIDEO_PROVIDER=auto
VIDEO_API_KEY=your_gemini_api_key_here
VIDEO_MODEL=veo-3.1-generate-preview
VIDEO_FALLBACK_TO_LOCAL=true
KENBURNS_WIDTH=1920
KENBURNS_HEIGHT=1080
KENBURNS_FPS=24

# JSON2Video cloud renderer (optional). Get a key at https://json2video.com/get-api-key/
# JSON2Video downloads each source photo by URL, so PUBLIC_BASE_URL must be reachable
# from the public internet (a tunnel, or your deployed backend host).
JSON2VIDEO_API_KEY=
JSON2VIDEO_API_URL=https://api.json2video.com/v2/movies
JSON2VIDEO_RESOLUTION=full-hd
JSON2VIDEO_POLL_INTERVAL_SECONDS=5
JSON2VIDEO_TIMEOUT_SECONDS=300
PUBLIC_BASE_URL=

VIDEO_DURATION_SECONDS=4
VIDEO_FPS=24
VIDEO_RESOLUTION=720p
MAX_CONCURRENT_GENERATIONS=1
VIDEO_SUBMISSION_INTERVAL_SECONDS=10
VIDEO_RATE_LIMIT_RETRY_ATTEMPTS=3
VIDEO_RATE_LIMIT_BACKOFF_SECONDS=15
MAX_GENERATION_RETRIES=3
# Local installation safety limits
MAX_IMAGES_PER_PROJECT=20
MAX_ACTIVE_PROJECTS=10
MAX_SCENES_PER_GENERATION_REQUEST=5
