# Backend Configuration
PROJECT_NAME="Image-to-Video Walkthrough Generation"
VERSION=0.6.0
API_PREFIX=/api
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origins whose hostname is not stable. Vercel assigns a NEW url to every preview
# deployment, so a static allow-list above breaks on each branch build. With the
# frontend on Vercel and the backend elsewhere, set this to keep previews working:
#   CORS_ORIGIN_REGEX=^https://[a-z0-9-]+(\.git-[a-z0-9-]+\.)?vercel\.app$
CORS_ORIGIN_REGEX=

# Durable project snapshots for Render's ephemeral filesystem. Keep the
# service-role key on the backend only; never expose it to the frontend.
REMOTE_STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=walkthrough-assets

# API access key (recommended whenever the backend is reachable from the internet).
# When set, every /api request must send it as the X-API-Key header (or ?key=).
# /api/health and the /file media routes stay open so the UI can load media.
# Leave blank for localhost-only development.
API_ACCESS_KEY=

# Image Constraints
# Enforced while the upload is still streaming, not after the whole body is in RAM.
MAX_IMAGE_SIZE_BYTES=20971520
# Decompression-bomb guard: a small file can declare an enormous canvas, and
# decoding it allocates width x height x 4 bytes. Checked before any decode.
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512

# AI Vision Model (Scene Understanding)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0

# Image-to-Video Provider
# VIDEO_PROVIDER options:
#   auto       -> best configured remote provider, local cinematic Ken Burns on
#                 quota / rate-limit / content-block / misconfiguration (recommended)
#   json2video -> JSON2Video cloud renderer (pan/zoom over the real photos; generous
#                 free tier; needs JSON2VIDEO_API_KEY and a public PUBLIC_BASE_URL)
#   magic_hour -> Magic Hour generative image-to-video (Kling / LTX / Veo / Seedance /
#                 Wan). Real motion and, unlike JSON2Video, no public URL needed because
#                 the photo is uploaded directly — but it synthesises pixels and can
#                 drift from the listing.
#   gemini_veo -> Google Veo only (true generative video; hardest free tier)
#   kenburns   -> fully local cinematic camera motion, no API and no quota
VIDEO_PROVIDER=auto
VIDEO_API_KEY=your_gemini_api_key_here
VIDEO_MODEL=veo-3.1-generate-preview
# Automatically degrade a quota/rate-limited clip to the local provider
VIDEO_FALLBACK_TO_LOCAL=true
# Local cinematic (Ken Burns) clip output
KENBURNS_WIDTH=1920
KENBURNS_HEIGHT=1080
KENBURNS_FPS=24

# 2.5D depth parallax for the local renderer.
# A monocular depth model estimates how far away every pixel is, and the camera
# then moves near pixels further than far pixels. That relative slide between
# planes is what makes a camera move over a still photograph read as footage
# instead of as a panning picture. Everything degrades safely: with no model file
# the renderer falls back to a flat affine move rather than failing.
#
# The model is not committed (it is ~100MB). Fetch it once with:
#   curl -L -o backend/models/depth_anything_v2_small.onnx \
#     https://huggingface.co/onnx-community/depth-anything-v2-small/resolve/main/onnx/model.onnx
# It needs `onnxruntime` (installed with the backend requirements).
DEPTH_MODEL_PATH=
DEPTH_PARALLAX_ENABLED=true
# How far the nearest plane slides relative to the farthest, as a fraction of the
# pan distance. Higher is punchier and more obviously 3D; too high and the
# disocclusion between planes starts to smear.
DEPTH_PARALLAX_STRENGTH=0.85
# Depth-proportional magnification during a push-in, so a foreground object grows
# faster than the wall behind it.
DEPTH_ZOOM_PARALLAX=0.55
# Trailing-shutter accumulation, in frames. Real cameras blur fast movement, which
# is one of the strongest "this is footage, not a still" cues. 0 disables it.
MOTION_BLUR_SHUTTER=0.62
# Depth-of-field: keeps the far plane slightly soft while the near plane stays
# crisp. 0 disables it (wide-angle interior photography is normally deep-focus).
RACK_FOCUS_STRENGTH=0.0

# JSON2Video cloud renderer (optional alternative to Veo's free-tier wall).
# Get a key at https://json2video.com/get-api-key/ (free tier includes 600s of render).
# JSON2Video downloads each source photo over HTTP, so PUBLIC_BASE_URL must be an
# address reachable from the internet (a tunnel, or your deployed backend host).
JSON2VIDEO_API_KEY=
JSON2VIDEO_API_URL=https://api.json2video.com/v2/movies
JSON2VIDEO_RESOLUTION=full-hd
JSON2VIDEO_POLL_INTERVAL_SECONDS=5.0
JSON2VIDEO_TIMEOUT_SECONDS=300.0
PUBLIC_BASE_URL=

# Magic Hour generative image-to-video (optional). Get a key at
# https://magichour.ai/developer
# The still is uploaded through POST /v1/files/upload-urls and referenced by the
# returned file_path, so NO public URL / tunnel is required — it works from localhost.
# The model re-synthesises the frame, so the property is not guaranteed pixel-exact;
# a missing key, exhausted credits, auth failure or timeout degrades the affected clip
# to the local renderer rather than failing the walkthrough.
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_API_URL=https://api.magichour.ai/v1
# Blank = use the model the plan is entitled to (paid -> kling-3.0, free -> ltx-2.5).
MAGIC_HOUR_MODEL=
# 360p | 480p | 720p | 1080p | 4k. Retried once without it if the plan rejects it.
MAGIC_HOUR_RESOLUTION=720p
# Off by default: the assembler owns the score and its cut accents.
MAGIC_HOUR_AUDIO=false
MAGIC_HOUR_POLL_INTERVAL_SECONDS=5.0
MAGIC_HOUR_TIMEOUT_SECONDS=900.0

VIDEO_DURATION_SECONDS=4
VIDEO_FPS=24
VIDEO_RESOLUTION=720p
MAX_CONCURRENT_GENERATIONS=1
VIDEO_SUBMISSION_INTERVAL_SECONDS=10
VIDEO_RATE_LIMIT_RETRY_ATTEMPTS=3
VIDEO_RATE_LIMIT_BACKOFF_SECONDS=15
MAX_GENERATION_RETRIES=3
# Local installation safety limits
MAX_IMAGES_PER_PROJECT=20
MAX_ACTIVE_PROJECTS=10
MAX_SCENES_PER_GENERATION_REQUEST=5
