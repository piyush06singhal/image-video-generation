# Backend Configuration
PROJECT_NAME="Image-to-Video Walkthrough Generation"
VERSION=0.6.0
API_PREFIX=/api
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Image Constraints
MAX_IMAGE_SIZE_BYTES=20971520
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512

# AI Vision Model (Scene Understanding)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0

# Video Diffusion Engine (Gemini Veo 2.0 / Veo 3.1)
VIDEO_PROVIDER=gemini_veo
VIDEO_API_KEY=your_gemini_api_key_here
VIDEO_MODEL=veo-3.1-generate-preview
VIDEO_DURATION_SECONDS=4
VIDEO_FPS=24
VIDEO_RESOLUTION=720p
MAX_CONCURRENT_GENERATIONS=2
MAX_GENERATION_RETRIES=3
