# Frontend configuration — copy to `.env.local` (git-ignored), or just run
# `python scripts/setup_env.py` from the repository root and let it do it.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
# Changing them requires restarting `next dev`, or a new Vercel deployment.

# Where the FastAPI backend lives.
#   local:    http://localhost:8000
#   deployed: the backend's own URL, e.g. https://cineestate-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret guarding the backend. Must be EXACTLY the same value as
# API_ACCESS_KEY in backend/.env — a mismatch is rejected with 401 on every call,
# which otherwise looks like a dead server.
#
# This is a public build-time variable, so it is only a speed bump for a
# tunnelled demo: it stops random scanners from spending your provider quota, it
# is not a substitute for real authentication. Leave it empty (and leave
# API_ACCESS_KEY empty) for localhost-only development.
NEXT_PUBLIC_API_KEY=
